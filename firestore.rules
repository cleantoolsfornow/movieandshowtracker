rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidAvatarField() {
      return request.resource.data.avatarDataUrl == null
        || (request.resource.data.avatarDataUrl is string
          && request.resource.data.avatarDataUrl.size() <= 60000);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);

      // Client can create its own profile on first sign-in only.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.householdId == null
        && hasValidAvatarField();

      // Client may refresh profile fields but cannot self-assign household membership.
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.householdId == resource.data.householdId
        && hasValidAvatarField();

      allow delete: if false;
    }

    // Current app uses server-side Admin SDK APIs for these collections.
    // Keep client access closed by default.
    match /households/{householdId} {
      allow read, write: if false;
    }

    match /titles/{titleId} {
      allow read, write: if false;
    }

    match /titleStatuses/{titleId} {
      allow read, write: if false;
    }
  }
}
